		"ol-ext": "^4.0.35",
		"proj4": "^2.11.0"
	},
	"devDependencies": {
		"@types/ol-ext": "npm:@siedlerchr/types-ol-ext@^3.6.5",
		"@types/proj4": "^2.5.5",
		"typescript": "^5.3.0",
		"vite": "^5.0.0"
	}
}
