{
	"name": "@ign/mobile-core",
	"version": "1.0.1",
	"description": "Core mapping and caching library for IGN mobile applications",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite build --watch",
		"build": "tsc && vite build",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit"
	},
	"author": "IGN",
	"license": "IGN",
	"dependencies": {
		"@capacitor/app": "^8.1.0",
		"@capacitor/browser": "^8.0.3",
		"@capacitor/core": "^8.3.0",
		"@capacitor/device": "^8.0.2",
		"collaboratif-client-api": "github:IGNF/collaboratif-client-api#2.0",
		"ol": "^10.6.1",
		"ol-ext": "^4.0.35",
		"proj4": "^2.11.0"
	},
	"devDependencies": {
		"@types/ol-ext": "npm:@siedlerchr/types-ol-ext@^3.6.5",
		"@types/proj4": "^2.5.5",
		"typescript": "^5.3.0",
		"vite": "^5.0.0"
	}
}
